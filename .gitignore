# Hostinger's shared-hosting build step can't execute native binaries
# (esbuild/rollup) — EACCES on spawnSync regardless of pnpm build-script
# config. Prebuild locally/in CI and commit the output so Hostinger only
# ever runs plain `node dist/index.mjs`, no native binary execution needed.
!artifacts/api-server/dist/
!artifacts/api-server/dist/**
!artifacts/support-connect/dist/
!artifacts/support-connect/dist/**
.env
.env.*
backups/
*.dump
*.mp4
*.mov
*.avi
*.mkv
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.mp3
*.wav
